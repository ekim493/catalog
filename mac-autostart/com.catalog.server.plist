<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.catalog.server</string>

    <!-- Edit both paths below before installing: your python3 path
         (`which python3`) and the full path to the catalog folder. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOURNAME/catalog/server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOURNAME/catalog</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/catalog-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/catalog-server.log</string>
</dict>
</plist>
